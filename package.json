{
  "name": "vector-migration-cli",
  "version": "1.0.0",
  "description": "ETL CLI tool for migrating relational REST API data to Qdrant Vector DB with local embeddings and Zod validation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "search": "tsx src/search-cli.ts"
  },
  "keywords": [
    "typescript",
    "qdrant",
    "etl",
    "zod",
    "vector-database",
    "transformers",
    "embeddings"
  ],
  "author": "Bryan Daniel Amaya",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "@xenova/transformers": "^2.17.1",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}